# Default AI provider for analyzePhoto when no id is passed: gemini | kimi
VITE_AI_PROVIDER=gemini

# Gemini (Google AI Studio)
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-3.5-flash

# Kimi / Moonshot (OpenAI-compatible)
# https://platform.kimi.ai/console/api-keys
VITE_KIMI_API_KEY=
VITE_KIMI_MODEL=kimi-k2.7-code
# China console (default in code): https://api.moonshot.cn/v1
# International keys: https://api.moonshot.ai/v1
# VITE_KIMI_BASE_URL=https://api.moonshot.cn/v1
